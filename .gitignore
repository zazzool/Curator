# Сборка
/server/curator
/web/dist
/web/node_modules
# Отметка о прошлой сборке типов: пишется `tsc -b` при сборке студии и
# зависит от того, что и когда собирали на этой машине.
/web/tsconfig.tsbuildinfo
/app/build
/app/.dart_tool

# Настройки среды: пароли базы и ключи моделей живут в окружении, а не здесь.
.env
*.env
!.env.example

# Конфигурация туннеля к поставщику моделей: в ней приватный ключ, а
# репозиторий публичный. Кладётся руками на контуре.
/vpn/

# Мусор редакторов
.DS_Store
*.swp

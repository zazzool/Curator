# Настройки ssh для выкатки со сторожа (.github/workflows/deploy.yml).
#
# Лежит отдельным файлом, а не строками внутри работы: там он был бы
# вложенным документом внутри YAML внутри shell, и правка любой из трёх
# оболочек ломала бы его молча.
Host *
    IdentityFile ~/.ssh/curator_deploy
    # Только этот ключ: без IdentitiesOnly ssh предъявит сперва всё, что
    # найдёт у агента, и хост оборвёт связь по счётчику попыток — отказом,
    # в котором про ключ выкатки не будет ни слова.
    IdentitiesOnly yes
    # Отпечаток хоста приезжает секретом и обязателен. Соблазн написать
    # здесь `no` велик — и это ровно тот случай, когда «лишь бы работало»
    # отдаёт root на контуре первому, кто сумеет ответить вместо него.
    StrictHostKeyChecking yes
    UserKnownHostsFile ~/.ssh/known_hosts
    # Ни одного вопроса в никуда: спросить здесь некого, и без BatchMode
    # выкатка висела бы до предела работы на приглашении ввести пароль.
    BatchMode yes
    # Сборка образа на хосте идёт минуты и всё это время молчит. Молчащую
    # связь режет что угодно по дороге, и обрыв читался бы как отказ
    # сборки. Ping раз в полминуты держит её живой.
    ServerAliveInterval 30
    ServerAliveCountMax 10

<?xml version="1.0" encoding="utf-8"?>
<!--
  Ничего с этого устройства не уезжает: ни в облачную копию, ни на новый
  телефон при переносе.

  Довод не про осторожность вообще, а про токен устройства. Сервер выдаёт
  его РОВНО ОДИН РАЗ и хранит у себя только отпечаток; лежит он открытой
  строкой в SharedPreferences. Уехавшая копия — это два устройства с
  одним токеном, то есть одна учётная запись в двух руках, и отозвать её
  можно только целиком, вместе с прогрессом врача.

  Второе — местная база. Восстановление кладёт `curator.db` версии N, а
  поэтапная выкладка ставит на новый телефон сборку N−1: база оказывается
  новее приложения, и справочник не открывается вовсе.

  Перенос записи у нас есть и без копии: почта. Он возвращает задачи,
  знаки и купленный доступ, и делает это на стороне сервера, не полагаясь
  на то, что телефон отдал файлы честно.

  Правила объявлены отдельно от android:allowBackup намеренно: с Android
  12 облачная копия и перенос «телефон в телефон» настраиваются порознь,
  и allowBackup сам по себе второго не закрывает.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

# Скопируйте в server/.env и подставьте значения. Сам .env в репозиторий не
# входит и входить не должен: секреты живут в окружении контура, а не в
# истории изменений, откуда их не вычистить.
#
# # Доступы берутся те же, что у проекта-донора (решение владельца)
#
# Куратор ходит к тем же службам, что MVExams: тот же сервер Postgres, тот
# же ключ поставщика моделей, та же почта, тот же выход через прокси. Имена
# переменных здесь свои, значения — оттуда. Где значение обязано отличаться,
# это сказано прямо.

# --- База ---
#
# Тот же сервер Postgres, но ОТДЕЛЬНАЯ база: Куратор стартует с чистой
# схемой, и делить таблицы с донором ему нельзя — у них разная модель
# задачи. Заводится как обычная база с собственной ролью.
#
# Пусто — сервер поднимается на хранилище в памяти, данные живут до
# перезапуска. Это нормальный режим для разработки и негодный для всего
# остального.
DATABASE_URL=postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/curator
CURATOR_ADDR=:8080

# Публичный адрес контура. Отсюда берутся ссылки в письмах, заголовок
# атрибуции у поставщика моделей и адрес страницы раздачи сборки. Одно
# место на весь проект: адрес, вписанный литералом во второй файл,
# расходится молча, и узнают об этом по чужому адресу в чужом журнале.
CURATOR_PUBLIC_URL=https://curator.psync.ru

# --- Студия ---
#
# Вход именованный: логин пользователя и одноразовый код. Пользователи
# лежат в базе, у каждого свой секрет и свои права.
#
# Эти две переменные — не вход, а посев первого пользователя. Читаются один
# раз и только когда в базе нет ни одного: иначе войти, чтобы завести
# первого, нельзя по кругу. После первого запуска их можно убрать.
CURATOR_ADMIN_LOGIN=editor
CURATOR_TOTP_SECRET=

# Origin студии для CORS. В разработке это dev-сервер Vite.
CURATOR_ADMIN_ORIGIN=http://localhost:5173

# Собранная студия для раздачи. Пусто — раздача статики выключена.
CURATOR_EDITOR_DIR=../web/dist

# --- Модели ---
#
# Ключ и учётная запись — донорские, те же самые. Без ключа генерация
# выключена, студия об этом сообщает, всё остальное работает.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=

# Прокси для запросов к поставщику моделей — и только к нему. Сайдкар тот
# же, что у донора, но под своим именем: сервис находится в сети по имени
# контейнера, и два контура, назвавшие сайдкар одинаково, увели бы трафик
# друг к другу.
CURATOR_LLM_PROXY=socks5://curator-llm-vpn:1080

# --- Почта ---
#
# Учётная запись донорская. Почта нужна для привязки адреса к учётной
# записи клиента и для восстановления доступа: без неё сменивший телефон
# теряет всё.
SMTP_HOST=smtp.go2.unisender.ru
SMTP_USER=
SMTP_PASSWORD=

# --- Подпись пакетов задач ---
#
# Закрытая половина ключа ed25519. Открытая уезжает в сборку приложения, и
# приложение сверяет подпись манифеста до установки пакета.
#
# Ключ здесь НЕ донорский, и это не выбор из осторожности: приложение
# Куратора новое, его сборки подписаны своим ключом, и общий ключ связал бы
# два продукта там, где связь не нужна никому.
PACK_SIGNING_KEY=

# Имя ключа. Уезжает в каждый выпуск и называет, каким из ключей он
# подписан: при смене ключа старые выпуски обязаны остаться проверяемыми
# прежним, а не стать негодными все разом.
#
# Сам ключ в выпуске НЕ уезжает. Отдай мы его той же дверью, что и пакет,
# подпись перестала бы значить что-либо: подменивший пакет по дороге
# подменил бы и ключ. Открытые ключи, которым верит приложение, приезжают
# в его сборке.
PACK_SIGNING_KEY_ID=key-1

# --- Снимки базы ---
#
# Пусто — снимки не снимаются вовсе, и задачи существуют в одном
# экземпляре. Отдельная база под проверку восстановлением обязана быть
# ОТДЕЛЬНОЙ: проверка очищает таблицы перед вставкой.
CURATOR_BACKUP_DIR=/data/backups
CURATOR_BACKUP_VERIFY_DSN=

# --- Проверки ---
#
# Строка подключения к одноразовой базе для проверок SQL. Без неё проверки
# на живой базе не идут — и это отказ, а не пропуск: набор, тихо
# пропускающий их, выдаёт зелёное за непроверенное.
CURATOR_TEST_DSN=
